# Copy to .env.local and fill in real values. Never commit real keys.

# PostHog (analytics, loaded only after consent). Project API key is public by design.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# "us" or "eu": the PostHog cloud region your project lives in.
NEXT_PUBLIC_POSTHOG_REGION=us

# Supabase (Pro waitlist). Server-only: no NEXT_PUBLIC_ prefix, never exposed to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

          "timeout": 10
        }
      },
      {
        "event": "Stop",
        "matcher": null,
        "hook": {
          "type": "command",
          "command": "python3",
          "args": [
            "${CLAUDE_PROJECT_DIR}/.claude/hooks/quality_gate.py",
